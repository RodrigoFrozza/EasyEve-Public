  ingestedAt DateTime @default(now())
}

model ExplorationLootEventFact {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  eventValue Decimal  @db.Decimal(20, 2)
  itemCount  Int
  occurredAt DateTime

  items ExplorationLootItemFact[]

  @@index([activityId])
  @@index([userId, occurredAt])
}

model ExplorationLootItemFact {
  id         String                   @id @default(cuid())
  eventId    String
  event      ExplorationLootEventFact @relation(fields: [eventId], references: [id], onDelete: Cascade)
  typeId     Int
