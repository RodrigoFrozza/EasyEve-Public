// Cooldown/dedupe state for proactive PI alerts (buffer starving/stalled/overflow,
// expired extractor). Colony buffer state is computed live from ESI on every scheduler
// run — nothing about it is persisted elsewhere — so this table is what lets the alert
// script tell "still the same open problem" apart from "this got worse again after
// resolving" (resolvedAt set = re-notify immediately even inside the cooldown window).
model PiPlanetAlert {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planetId        Int
  alertType       String // "starving_soon" | "stalled" | "overflow_soon" | "full" | "extractor_expired"
  // 0 = colony-level alert (no specific pin — real ESI pin ids are always > 0).
  // A plain nullable column here would break upsert dedup: Postgres never treats
  // two NULLs as conflicting in a unique index, so pinId:null would insert a fresh
  // row every run instead of updating the existing cooldown record.
  pinId           Int       @default(0)
  typeId          Int?
  lastTriggeredAt DateTime  @default(now())
  lastNotifiedAt  DateTime  @default(now())
  resolvedAt      DateTime?

  @@unique([userId, planetId, alertType, pinId])
  @@index([userId])
  @@index([planetId])
  @@index([lastNotifiedAt])
}

