generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  accountCode       String?  @unique
  email             String?
  name              String?
  role              String   @default("user") // master, user
  allowedActivities String[] @default([])

  // Subscription & Blocking
  isBlocked       Boolean   @default(false)
  blockedAt       DateTime?
  blockReason     String?
  subscriptionEnd DateTime?

  // ISK Balance (1 ISK transferred = 1 ISK credited)
  iskBalance Float @default(0)

  // Future Integrations & Tracking
  lastLoginAt        DateTime?
  discordId          String?
  discordName        String?
  isTester           Boolean   @default(false)
  testerApprovedAt   DateTime?
  testerRevokedAt    DateTime?
  testerApprovedById String?
  testerRevokedById  String?

  characters              Character[]
  fits                    Fit[]
  activities              Activity[]
  payments                Payment[]
  activationCodes         ActivationCode[]
  createdCodes            ActivationCode[]         @relation("CreatedCodes")
  promoBannerInteractions PromoBannerInteraction[]
  debugLogs               DebugLog[]
  iskHistory              IskHistory[]

  // Player Profile Relations
  profile                    UserProfile?
  reputationHistory          ReputationHistory[]
  medals                     MedalAward[]
  sentMessages               PlayerMessage[]     @relation("SenderMessages")
  receivedMessages           PlayerMessage[]     @relation("ReceiverMessages")
  contacts                   UserContact[]       @relation("UserContacts")
  contactOf                  UserContact[]       @relation("ContactOfUser")
  notifications              Notification[]
  customScriptMemos          CustomScriptMemo[]
  testerApplications         TesterApplication[] @relation("TesterApplicationsOwner")
  reviewedTesterApplications TesterApplication[] @relation("TesterApplicationsReviewer")
  piPlanetConfigs            PiPlanetConfig[]
  piReferencePrices          PiReferencePrice[]
  piPlanetAlerts             PiPlanetAlert[]
  appraisals                 Appraisal[]
  industryConfig             IndustryConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([role, subscriptionEnd])
  @@index([subscriptionEnd])
  @@index([isBlocked])
  @@index([isTester])
}

model TesterApplication {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("TesterApplicationsOwner", fields: [userId], references: [id], onDelete: Cascade)
  status          String    @default("pending") // pending, approved, rejected
  description     String    @db.Text
  rulesAcceptedAt DateTime
  reviewNotes     String?   @db.Text
  reviewedById    String?
  reviewedBy      User?     @relation("TesterApplicationsReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  cooldownUntil   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Character {
  id             Int       @id
  name           String
  ownerHash      String    @unique
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  totalSp       Int      @default(0)
  walletBalance Float    @default(0)
  location      String?
  ship          String?
  shipTypeId    Int?
  tags          String[] // Planner categories

  esiApp        String  @default("main") // "main" or "holding"
  isMain        Boolean @default(false)
  isCorpManager Boolean @default(false) // Designated for corp wallet sync
  corporationId Int?

  // Character Profile (public info from ESI, persisted on refresh)
  birthday       DateTime?
  raceId         Int?
  bloodlineId    Int?
  gender         String?
  securityStatus Float?
  isOmega        Boolean? // Manual toggle — ESI does not expose Alpha/Omega status
  shareToken     String? // Secret token for the public shareable profile link. Not @unique: adding a unique constraint to an existing table makes `prisma db push` (boot-time deploy) refuse without --accept-data-loss; uniqueness is guaranteed by the token's 128-bit entropy instead.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  snapshot CharacterSnapshot?

  blueprints CharacterBlueprint[]

  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isMain])
  @@index([name])
  @@index([ship])
  @@index([corporationId])
  @@index([shareToken])
}

model CharacterSnapshot {
  id          String    @id @default(cuid())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  totalSp       Int  @default(0)
  unallocatedSp Int?

  skills     Json // [{ skill_id, skillpoints_in_skill, trained_skill_level, active_skill_level }]
  skillqueue Json // ESI skillqueue entries (finish_date/start_date included)
  attributes Json // { charisma, intelligence, memory, perception, willpower, bonus_remaps?, last_remap_date?, accrued_remap_cooldown_date? }
  implants   Json? // Array of implant type IDs

  capturedAt DateTime @default(now())
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount             Float
  monthsPaid         Int     @default(1)
  payerCharacterId   Int?
  payerCharacterName String?
  journalId          String? @unique // ESI wallet journal ID to prevent duplicates

  status  String   @default("pending") // pending, approved, rejected
  modules String[] // Modules this payment is for

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  @@index([userId])
  @@index([journalId])
  @@index([payerCharacterName])
  @@index([status])
}

model ModulePrice {
  id        String   @id @default(cuid())
  module    String   @unique // e.g., "ratting", "mining"
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Visibility {
  PUBLIC
  PROTECTED
}

model Fit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  ship        String
  shipTypeId  Int?

  modules Json  @default("[]") // Array of modules
  drones  Json? @default("[]") // Array of drones
  cargo   Json? @default("[]") // Array of cargo items

  tags       String[]   @default([])
  visibility Visibility @default(PROTECTED)

  esiData Json? // Snapshot of ship stats from ESI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, visibility])
  @@index([visibility])
  @@index([visibility, updatedAt])
  @@map("fits")
}

model Activity {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId Int?

  type      String // EX: MINING, RATTING, ABYSSAL, EXPLORATION, ESCALATIONS, CRAB, PVP
  status    String    @default("active") // active, completed
  startTime DateTime  @default(now())
  endTime   DateTime?

  // Link to the primary item for this activity (e.g., the ship used or the key item)
  typeId Int?
  item   EveType? @relation(fields: [typeId], references: [id])

  // Contextual information
  region String?
  space  String?

  // Dynamic Activity Data (JSON for flexibility and easy copying/pasting)
  // Mining: { oreMined: { typeId: count } }
  // Ratting: { mtuContents: [{ typeId: count }], totalBounty: number }
  // Abyssal: { lootBefore: string, lootAfter: string, tier: string, weather: string }
  data Json? @default("{}")

  participants Json @default("[]") // [{"characterId": 123, "fit": "optional"}]

  // Pause States for time tracking
  isPaused              Boolean   @default(false)
  pausedAt              DateTime?
  accumulatedPausedTime Int       @default(0) // in milliseconds

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([characterId])
  @@index([status])
  @@index([type])
  @@index([typeId])
  // Composite indexes for leaderboard queries optimization
  @@index([type, startTime])
  @@index([userId, startTime])
  @@index([userId, type, startTime])
  @@index([userId, status, type])
  @@index([type, startTime, isDeleted])
  @@index([status, startTime])
  // Unified activity background sync: filter by flags + order by updatedAt; completed mining by endTime window
  @@index([isDeleted, isPaused, status, updatedAt])
  @@index([type, status, endTime, isDeleted, isPaused])
}

// --- Salvaging loot intelligence (cross-user aggregates, completed sessions only) ---

model SalvageAnalyticsIngestion {
  activityId         String   @id
  ingestedAt         DateTime @default(now())
  ingestedDurationMs BigInt?
  ingestedNpcFaction String?
}

model SalvageBatchFact {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  npcFaction String
  spaceType  String
  batchValue Decimal  @db.Decimal(20, 2)
  itemCount  Int
  occurredAt DateTime

  items SalvageBatchItemFact[]

  @@index([activityId])
  @@index([userId, occurredAt])
  @@index([npcFaction, spaceType, occurredAt])
}

model SalvageBatchItemFact {
  id         String           @id @default(cuid())
  batchId    String
  batch      SalvageBatchFact @relation(fields: [batchId], references: [id], onDelete: Cascade)
  typeId     Int
  itemName   String
  quantity   Int
  unitPrice  Decimal          @db.Decimal(20, 2)
  totalValue Decimal          @db.Decimal(20, 2)

  @@index([batchId])
  @@index([typeId])
}

model SalvageFactionRollup {
  id              String  @id @default(cuid())
  npcFaction      String
  /// "" = aggregated across all space types for this faction
  spaceType       String  @default("")
  totalBatches    Int     @default(0)
  totalValue      Decimal @default(0) @db.Decimal(20, 2)
  totalDurationMs BigInt  @default(0)

  @@unique([npcFaction, spaceType])
  @@index([npcFaction])
}

model SalvageItemRollup {
  id              String  @id @default(cuid())
  npcFaction      String
  spaceType       String  @default("")
  typeId          Int
  itemName        String
  batchesWithItem Int     @default(0)
  totalQuantity   Int     @default(0)
  totalValue      Decimal @default(0) @db.Decimal(20, 2)

  @@unique([npcFaction, spaceType, typeId])
  @@index([npcFaction, spaceType])
}

// --- Ratting loot intelligence ---

model RattingLootAnalyticsIngestion {
  activityId         String   @id
  ingestedAt         DateTime @default(now())
  ingestedDurationMs BigInt?
  ingestedNpcFaction String?
}

model RattingLootEventFact {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  npcFaction String
  spaceType  String
  eventValue Decimal  @db.Decimal(20, 2)
  itemCount  Int
  occurredAt DateTime

  items RattingLootItemFact[]

  @@index([activityId])
  @@index([userId, occurredAt])
  @@index([npcFaction, spaceType])
}

model RattingLootItemFact {
  id         String               @id @default(cuid())
  eventId    String
  event      RattingLootEventFact @relation(fields: [eventId], references: [id], onDelete: Cascade)
  typeId     Int
  itemName   String
  quantity   Int
  unitPrice  Decimal              @db.Decimal(20, 2)
  totalValue Decimal              @db.Decimal(20, 2)

  @@index([eventId])
  @@index([typeId])
}

model RattingLootDimensionRollup {
  id              String  @id @default(cuid())
  npcFaction      String
  spaceType       String  @default("")
  totalEvents     Int     @default(0)
  totalValue      Decimal @default(0) @db.Decimal(20, 2)
  totalDurationMs BigInt  @default(0)

  @@unique([npcFaction, spaceType])
  @@index([npcFaction])
}

model RattingLootItemRollup {
  id             String  @id @default(cuid())
  npcFaction     String
  spaceType      String  @default("")
  typeId         Int
  itemName       String
  eventsWithItem Int     @default(0)
  totalQuantity  Int     @default(0)
  totalValue     Decimal @default(0) @db.Decimal(20, 2)

  @@unique([npcFaction, spaceType, typeId])
  @@index([npcFaction, spaceType])
}

// --- Mining loot intelligence ---

model MiningLootAnalyticsIngestion {
  activityId             String   @id
  ingestedAt             DateTime @default(now())
  ingestedDurationMs     BigInt?
  ingestedSpaceType      String?
  ingestedMiningCategory String?
}

model MiningLootEventFact {
  id             String   @id @default(cuid())
  activityId     String
  userId         String
  miningCategory String
  spaceType      String
  regionId       Int?
  regionName     String?
  eventValue     Decimal  @db.Decimal(20, 2)
  itemCount      Int
  occurredAt     DateTime

  items MiningLootItemFact[]

  @@index([activityId])
  @@index([userId, occurredAt])
  @@index([miningCategory])
  @@index([regionId])
}

model MiningLootRegionRollup {
  id              String  @id @default(cuid())
  miningCategory  String
  regionId        Int
  regionName      String
  totalEvents     Int     @default(0)
  totalValue      Decimal @default(0) @db.Decimal(20, 2)
  totalDurationMs BigInt  @default(0)

  @@unique([miningCategory, regionId])
  @@index([miningCategory])
  @@index([regionId])
}

model MiningLootItemFact {
  id         String              @id @default(cuid())
  eventId    String
  event      MiningLootEventFact @relation(fields: [eventId], references: [id], onDelete: Cascade)
  typeId     Int
  itemName   String
  quantity   Int
  unitPrice  Decimal             @db.Decimal(20, 2)
  totalValue Decimal             @db.Decimal(20, 2)

  @@index([eventId])
  @@index([typeId])
}

model MiningLootDimensionRollup {
  id              String  @id @default(cuid())
  miningCategory  String
  spaceType       String  @default("")
  totalEvents     Int     @default(0)
  totalValue      Decimal @default(0) @db.Decimal(20, 2)
  totalDurationMs BigInt  @default(0)

  @@unique([miningCategory, spaceType])
  @@index([miningCategory])
}

model MiningLootItemRollup {
  id             String  @id @default(cuid())
  miningCategory String
  spaceType      String  @default("")
  typeId         Int
  itemName       String
  eventsWithItem Int     @default(0)
  totalQuantity  Int     @default(0)
  totalValue     Decimal @default(0) @db.Decimal(20, 2)

  @@unique([miningCategory, spaceType, typeId])
  @@index([miningCategory, spaceType])
}

