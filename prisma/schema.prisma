model ExplorationLootDimensionRollup {
  bucketKey       String  @id @default("global")
  totalEvents     Int     @default(0)
  totalValue      Decimal @default(0) @db.Decimal(20, 2)
  totalDurationMs BigInt  @default(0)
}

model ExplorationLootItemRollup {
  id             String  @id @default(cuid())
  bucketKey      String  @default("global")
  typeId         Int
  itemName       String
  eventsWithItem Int     @default(0)
  totalQuantity  Int     @default(0)
  totalValue     Decimal @default(0) @db.Decimal(20, 2)

  @@unique([bucketKey, typeId])
}

// --- Abyssal loot intelligence ---

model AbyssalLootAnalyticsIngestion {
  activityId String   @id
  ingestedAt DateTime @default(now())
}

model AbyssalLootEventFact {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  tier       String
  weather    String
  eventValue Decimal  @db.Decimal(20, 2)
  itemCount  Int
  occurredAt DateTime
  durationMs BigInt   @default(0)

  items AbyssalLootItemFact[]

  @@index([activityId])
  @@index([userId, occurredAt])
  @@index([tier, weather])
}

model AbyssalLootItemFact {
  id         String               @id @default(cuid())
  eventId    String
  event      AbyssalLootEventFact @relation(fields: [eventId], references: [id], onDelete: Cascade)
  typeId     Int
  itemName   String
  quantity   Int
  unitPrice  Decimal              @db.Decimal(20, 2)
  totalValue Decimal              @db.Decimal(20, 2)

  @@index([eventId])
  @@index([typeId])
}

model AbyssalLootDimensionRollup {
  id              String  @id @default(cuid())
  tier            String
  weather         String
  totalEvents     Int     @default(0)
  totalValue      Decimal @default(0) @db.Decimal(20, 2)
  totalDurationMs BigInt  @default(0)

  @@unique([tier, weather])
  @@index([tier])
}

model AbyssalLootItemRollup {
  id             String  @id @default(cuid())
  tier           String
  weather        String
  typeId         Int
  itemName       String
  eventsWithItem Int     @default(0)
  totalQuantity  Int     @default(0)
  totalValue     Decimal @default(0) @db.Decimal(20, 2)

  @@unique([tier, weather, typeId])
  @@index([tier, weather])
}

// --- NEW UNIFIED SDE INFRASTRUCTURE ---

model EveType {
  id          Int      @id
  name        String
  description String?  @db.Text
  groupId     Int
  raceId      Int?
  factionId   Int?
  group       EveGroup @relation(fields: [groupId], references: [id])
  volume      Float?
  basePrice   Float?
  iconId      Int?
  published   Boolean  @default(true)

  activities Activity[]
  shipStats  ShipStats?

  marketGroupId Int?
  marketGroup   EveMarketGroup? @relation(fields: [marketGroupId], references: [id])

  // SDE metaGroupID: 1=Tech I, 2=Tech II, 3=Storyline, 4=Faction, 5=Officer,
  // 6=Deadspace, 14=Tech III, 15=Abyssal, 52=Structure Faction, 53/54=Structure T2/T1.
  // Drives the "what to produce" tech/faction classification (faction items are
  // gated to owned blueprints). Null = unclassified (treated as Tech I baseline).
  metaGroupId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([raceId])
  @@index([factionId])
  @@index([marketGroupId])
  @@index([metaGroupId])
}

model EveMarketGroup {
  id            Int              @id
  name          String
  description   String?          @db.Text
  parentGroupId Int?
  parentGroup   EveMarketGroup?  @relation("MarketGroupHierarchy", fields: [parentGroupId], references: [id])
  childGroups   EveMarketGroup[] @relation("MarketGroupHierarchy")
  types         EveType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentGroupId])
}

model EveGroup {
  id         Int         @id
  name       String
  categoryId Int
  category   EveCategory @relation(fields: [categoryId], references: [id])
  types      EveType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model EveCategory {
  id     Int        @id
  name   String
  groups EveGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SdeCache {
  id        String    @id @default(cuid())
  key       String    @unique
  value     Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([expiresAt])
}

model DebugLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId Int?
  level       String   @default("info") // info, warn, error, debug
  message     String   @db.Text
  stack       String?  @db.Text
  url         String?
  userAgent   String?
  context     Json? // Extra contextual data
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([characterId])
  @@index([createdAt])
}

// === SDE: Ship Stats ===
model ShipStats {
  typeId      Int     @id
  name        String
  raceId      Int?
  groupId     Int?
  factionName String?
  groupName   String?

  // Slots
  highSlots      Int @default(0)
  medSlots       Int @default(0)
  lowSlots       Int @default(0)
  rigSlots       Int @default(0)
  subsystemSlots Int @default(0)

  // Requirements
  cpu         Float @default(0)
  powerGrid   Float @default(0)
  calibration Float @default(0)

  // Capacities
  capacitor         Float @default(0)
  capacitorRecharge Float @default(0)
  shieldCapacity    Float @default(0)
  armorHP           Float @default(0)
  hullHP            Float @default(0)

  // Resistances (percentage - ex: 0.5 = 50%)
  shieldEmResist    Float @default(0)
  shieldExpResist   Float @default(0)
  shieldKinResist   Float @default(0)
  shieldThermResist Float @default(0)

  armorEmResist    Float @default(0)
  armorExpResist   Float @default(0)
  armorKinResist   Float @default(0)
  armorThermResist Float @default(0)

  hullEmResist    Float @default(0)
  hullExpResist   Float @default(0)
  hullKinResist   Float @default(0)
  hullThermResist Float @default(0)

  // Speed
  maxVelocity Float @default(0)
  agility     Float @default(1)
  mass        Float @default(0)
  warpSpeed   Float @default(0)
  alignTime   Float @default(0)

  // Cargo
  droneBay       Float @default(0)
  droneBandwidth Float @default(0)
  cargo          Float @default(0)

  // Targeting
  maxLockedTargets Int    @default(5)
  maxTargetRange   Float  @default(50000)
  signatureRadius  Float  @default(100)
  scanResolution   Float  @default(100)
  sensorStrength   Float  @default(0)
  sensorType       String @default("")

  // Scan (legacy - kept for compatibility)
  scanRange     Float @default(0)
  scanResolving Float @default(0)

  // Hardpoints
  turretHardpoints   Int @default(0)
  launcherHardpoints Int @default(0)

  // Restrictions (rigSize, etc)
  restrictions Json @default("{}")

  // Meta
  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dogmaAttributes ShipDogmaAttribute[]
  traits          ShipTrait[]
  eveType         EveType              @relation(fields: [typeId], references: [id])
}

// === SDE: Ship Traits (Ship Bonuses) ===
model ShipTrait {
  id         String  @id @default(cuid())
  shipTypeId Int
  bonus      Float?
  bonusText  String?
  unit       String?
  skillID    Int? // The skill that gives this bonus
  isFixed    Boolean @default(false) // If true, it's a fixed trait (Role Bonus)

  ship ShipStats @relation(fields: [shipTypeId], references: [typeId], onDelete: Cascade)

  @@index([shipTypeId])
}

// === SDE: Ship Dogma Attributes (additional attributes) ===
model ShipDogmaAttribute {
  id            String @id @default(cuid())
  shipTypeId    Int
  attributeId   Int
  attributeName String
  value         Float

  ship ShipStats @relation(fields: [shipTypeId], references: [typeId], onDelete: Cascade)

  @@unique([shipTypeId, attributeId])
  @@index([shipTypeId])
  @@index([attributeId])
  @@index([attributeName])
}

// === SDE: Module Stats ===
model ModuleStats {
  typeId        Int     @id
  name          String
  groupId       Int?
  groupName     String?
  categoryId    Int?
  metaLevel     Int?
  metaGroupName String?
  price         Float?

  // Requirements
  cpu       Float @default(0)
  powerGrid Float @default(0)

  // Slot type
  slotType String? // "high", "med", "low", "rig", "subsystem"

  // Combat stats
  damage        Float @default(0) // DPS base
  fireRate      Float @default(0) // Seconds between shots
  optimalRange  Float @default(0) // Optimal range (m)
  falloffRange  Float @default(0) // Falloff (m)
  trackingSpeed Float @default(0) // Tracking

  // Missile specific
  missileDamage   Float @default(0)
  missileRange    Float @default(0)
  missileVelocity Float @default(0)

  // Tank stats
  shieldBoost Float @default(0) // HP/s shield repair
  armorRepair Float @default(0) // HP/s armor repair
  hullRepair  Float @default(0) // HP/s hull repair

  // Capacitor
  capacitorNeed  Float @default(0) // Cap per cycle
  capacitorDrain Float @default(0) // Cap per second

  // Electronic Warfare
