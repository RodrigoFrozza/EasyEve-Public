// A saved market appraisal (Janice-style): a pasted item list priced against a
// chosen market (Jita region, or a private structure the account can dock at),
// with a public shareable link (`shareToken`). `items` holds the priced line
// items (see AppraisalLineItem in src/lib/appraisal/types.ts) as a snapshot —
// prices are frozen at creation time so a shared link stays reproducible even
// after the order book moves.
model Appraisal {
  id         String @id @default(cuid())
  shareToken String @unique
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketKind  String // 'jita' | 'structure'
  structureId String? // set when marketKind = 'structure'
  marketLabel String // human label shown in UI ('Jita 4-4', structure name)

  // Where the physical items are, free text entered by the creator (e.g. 'Jita 4-4',
  // 'Amarr VIII - Emperor Family Academy'). Shown on the share page so a buyer knows
  // where a contract would be picked up. Optional — never invented.
  itemsLocation    String?
  // Contract price knob: creator's asking price as a % of the priced value (e.g. 92 =
  // sell at 92% of buy, 150 = 150% of sell). Persisted so the shared link carries the
  // seller's intent; the share page still lets a viewer re-tweak it live.
  priceModifierPct Float   @default(100)
  // Free-text note from the creator ("accepting trades", "message me on Discord").
  // Shown in the share page's collapsed advanced card. Optional — never invented.
  comments         String? @db.Text

  items           Json     @default("[]")
  // Every pasted line as typed, BEFORE merging identical items — one entry per
  // paste-time line, preserving order and duplicates: { typeId, name, quantity }[].
  // Powers the "stack" toggle (merged vs separate lines) on the share page. `items`
  // above stays the merged-by-typeId source of truth for pricing/totals either way.
  rawEntries      Json     @default("[]")
  unresolvedNames String[] @default([])

  totalBuy   Float @default(0)
  totalSell  Float @default(0)
  totalSplit Float @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// Industry blueprint catalogue, imported from CCP's official SDE (blueprints.jsonl).
// Static game data (the recipes), distinct from a character's owned blueprints (ESI).
// Times are per-activity, in seconds; only the activities a blueprint actually has
// are set. Materials/products are captured for the item-producing activities
// (manufacturing, reaction, invention) — copying/research have no I/O to price.
model Blueprint {
  blueprintTypeId    Int  @id
  maxProductionLimit Int?
  manufacturingTime  Int?
  reactionTime       Int?
  inventionTime      Int?

  materials BlueprintMaterial[]
  products  BlueprintProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlueprintMaterial {
  id              String    @id @default(cuid())
  blueprintTypeId Int
  blueprint       Blueprint @relation(fields: [blueprintTypeId], references: [blueprintTypeId], onDelete: Cascade)
  activity        String // 'manufacturing' | 'reaction' | 'invention'
  typeId          Int // input material type
  quantity        Int

  @@index([blueprintTypeId, activity])
  @@index([typeId])
}

model BlueprintProduct {
  id              String    @id @default(cuid())
  blueprintTypeId Int
  blueprint       Blueprint @relation(fields: [blueprintTypeId], references: [blueprintTypeId], onDelete: Cascade)
  activity        String // 'manufacturing' | 'reaction' | 'invention'
  typeId          Int // output product type
  quantity        Int
  probability     Float? // invention only (< 1); null for guaranteed outputs

  // Reverse lookup "which blueprint produces this type" drives the What-to-produce tab.
  @@index([typeId, activity])
  @@index([blueprintTypeId, activity])
}

// Per-user Industry module settings (the config modal). Kept in one row with JSON
// lists rather than many columns because hubs are a variable-length set.
// `buyHubs`: [{ kind: 'region' | 'structure', id: string, name: string }] — the
// hubs whose prices are compared for input materials. `sellHub`: same shape or
// null. `factory` reserved for phase B (structure type + rigs + security for the
// EVE Ref ME/rig discount). All fields have safe defaults so a missing row = "not
// configured yet", never an error.
model IndustryConfig {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyHubs           Json     @default("[]")
  sellHub           Json?
  defaultMe         Int      @default(0)
  factory           Json?
  // Structures the "what to produce" deficit scanner sweeps. [{kind:'structure',id,name}]
  monitoredStations Json     @default("[]")
  // Sales tax / broker fee percent (e.g. 2.25 = 2.25%). Null = not configured, never applied silently.
  salesTaxPct       Float?
  brokerFeePct      Float?
  // Character whose Industry/Advanced Industry skills feed the build-time (ISK/h)
  // calc. Null = no skill bonus (labeled). Not a FK: keeps this config decoupled
  // from the Character table's lifecycle (a relinked/removed char just falls back
  // to "no skill bonus" instead of cascading).
  industryCharacterId Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Daily snapshot of a monitored private-structure market's per-type order book,
// captured by the deficit scanner. ESI has no public history endpoint for structure
// markets (unlike NPC regions), so this is our only source of price/volume history
// for private markets — feeds future liquidity ranking. One row per structure+type+day
// (last write wins); `capturedAt` tracks when that row was last overwritten.
model StationMarketSnapshot {
  id          String   @id @default(cuid())
  structureId String
  typeId      Int
  day         DateTime @db.Date
  // Float, not Int: total listed volume of a mineral at a big null hub can exceed
  // 2^31 units; doubles are exact for integers up to 2^53, plenty for volumes.
  sellVolume  Float
  buyVolume   Float
  bestSell    Float
  bestBuy     Float
  capturedAt  DateTime @default(now())

  @@unique([structureId, typeId, day])
  @@index([structureId, typeId, day])
  @@index([day])
}

// Pre-computed daily market snapshot of an NPC region (from ESI public market
// history), one row per region+type+day. Feeds the "what to produce" engine's
// broad scan: pricing thousands of manufacturable items live per request is
// infeasible (history is 1 ESI call/type, refreshes 1x/day), so an Admin Script
// (snapshot-region-market) precomputes this once a day and the engine reads it.
// `avgPrice`/`dailyVolume` are recent-days averages from market history — the
// velocity (dailyVolume) is the real "does it actually sell" (SVR) signal.
model RegionMarketDaily {
  id          String   @id @default(cuid())
  regionId    Int
  typeId      Int
  day         DateTime @db.Date
  avgPrice    Float // recent daily average traded price
  dailyVolume Float // recent daily units traded — the SVR velocity signal
  capturedAt  DateTime @default(now())

  @@unique([regionId, typeId, day])
  @@index([regionId, day])
  @@index([regionId, typeId, day])
}

// A character's owned blueprints, synced from ESI GET /characters/{id}/blueprints/
// (scope esi-characters.read_blueprints.v1). Lets the Industry cost calculator offer
// the user's REAL ME/TE instead of an assumed default — the trust model competitors
// like EVE IPH use. Replaced wholesale per character on each sync (blueprints move,
// get researched, or get sold constantly; stale rows are worse than a fresh sweep),
// never partially merged.
//
// ESI field semantics confirmed against https://esi.evetech.net/latest/swagger.json
// (GET /characters/{character_id}/blueprints/), 2026-07-16:
//   - Pagination: standard ESI x-pages response header, page query param, up to 1000
//     items per page.
//   - quantity (int32, min -2, no documented maximum): "-1 is an original and -2 is a
//     copy". No other value is documented. isCopy is derived from this field at sync
//     time (see deriveIsCopy in blueprint-sync.ts) so consumers don't re-derive it;
//     any quantity outside {-1, -2} is logged as unexpected and conservatively
//     treated as a copy rather than silently misclassified as an original.
//   - runs (int32, min -1): "-1 if original", otherwise "number of runs remaining if
//     blueprint is a copy".
//   - material_efficiency: 0-25. time_efficiency: 0-20.
//   - item_id/location_id are ESI int64 — stored as Postgres BIGINT (Prisma BigInt).
model CharacterBlueprint {
  id          String    @id @default(cuid())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  itemId             BigInt // ESI item_id — unique per blueprint instance
  typeId             Int // blueprint type (== Blueprint.blueprintTypeId)
  locationId         BigInt
  materialEfficiency Int
  timeEfficiency     Int
  runs               Int // -1 for an original (BPO); remaining runs for a copy (BPC)
  quantity           Int // raw ESI sentinel: -1 = original, -2 = copy (see isCopy)
  isCopy             Boolean // derived from quantity at sync time

  syncedAt DateTime

  @@unique([characterId, itemId])
  @@index([typeId])
  @@index([characterId])
}
